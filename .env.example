# ==============================================================================
# JSBrother Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# LLM Endpoint Mode ('mock' for local dev without GPU, 'remote' for Kaggle/Colab)
LLM_MODE=mock

# Remote LLM endpoint (FastAPI on Kaggle/Colab exposed via ngrok)
LLM_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
LLM_API_KEY=your_secret_bearer_key_here

# Gmail SMTP configuration (used in M7 Action Agent)
# Requires 2-Step Verification and a Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_character_app_password

# Safety toggle: dry-run ON by default (logs actions without sending emails)
EMAIL_DRY_RUN=true
